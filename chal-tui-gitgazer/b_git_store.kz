// Increment B — subprocess → reactive store.
//
// Each `git status --porcelain` line is moved into a std/store as an OWNED
// string row (the 690_053 dance: from-page -> take -> insert), and a store
// `query` fires per insert (690_005 model) to read the row back out. This is
// the subprocess→store bridge: a live process's output becoming reactive rows.
//
// Composition under test: an owned-string obligation flow (| ok / | err /
// | row) nested INSIDE a per-line effect handler (`! line`), feeding a plural
// owned-string store, with a reactive query projecting each row.

~import std/io
~import std/string
~import std/store

const std = @import("std");

~tor git-lines {}
! line string
| done usize
| failed string

~proc git-lines|zig {
    const __gg_alloc = std.heap.page_allocator;
    const __gg_res = std.process.Child.run(.{
        .allocator = __gg_alloc,
        .argv = &[_][]const u8{ "git", "status", "--porcelain" },
    }) catch |err| {
        return .{ .failed = @errorName(err) };
    };
    defer __gg_alloc.free(__gg_res.stdout);
    defer __gg_alloc.free(__gg_res.stderr);

    const __gg_ok = __gg_res.term == .Exited and __gg_res.term.Exited == 0;
    if (!__gg_ok) {
        return .{ .failed = "git exited nonzero" };
    }

    var __gg_n: usize = 0;
    var __gg_it = std.mem.splitScalar(u8, __gg_res.stdout, '\n');
    while (__gg_it.next()) |__gg_raw| {
        if (__gg_raw.len == 0 and __gg_it.peek() == null) break;
        line(__gg_raw);
        __gg_n += 1;
    }
    return .{ .done = __gg_n };
}

~std/store:new(gitfiles, capacity: 256) { name: *std/string:String<std/string:instance!> }

// Reactive query: fires per matching insert, borrows the owned string, reads it.
~std/store:query(gitfiles)
! query { entity.name } |> std/string:read(s: name): text |> std/io:print.ln("row: {{ text:s }}")

// Drive: each git line becomes an owned-string row.
~git-lines()
! line l |> std/string:from-page(text: l)
    | ok s |> std/string:take(s): owned |> std/store:insert(gitfiles) { name: owned }
        | row _ |> _
    | err _ |> _
| done n |> std/io:print.ln("inserted {{ n:d }} rows")
| failed e |> std/io:print.ln("git failed: {{ e:s }}")
