// Increment C — the full convergence: subprocess + reactive store + vaxis TUI.
//
// `git status --porcelain` runs as a subprocess (FFI, no std/process exists),
// streaming each line as an effect carrying its ordinal `! line { text, idx }`.
// On vaxis mount (`! draw`), git-lines runs; each line moves into a plural
// std/store as a MIXED row `{ name: owned-string, y: scalar }` (690_064 shape),
// and the store's reactive `query` fires per insert, painting that row into the
// vaxis surface at its own screen line. q quits.
//
//   ! draw ─> git-lines (subprocess) ─> ! line{text,idx}
//           ─> from-page/take ─> store insert{name,y}
//           ─> query fires ─> string:read ─> vaxis:write-at(y) ─> render
//
// Three effect sources coexist in one program: vaxis `run`, the store `query`,
// and the `git-lines` FFI effect — the store↔vaxis convergence driven by a live
// subprocess. Reach: nesting an owned-string obligation flow AND a nested
// effect-flow invocation inside a vaxis effect handler, with a reactive query
// bridging store writes to terminal paints.
//
// KNOWN LIMITATION (holes/1_store_no_ondemand_iteration): the list repaints
// only because the INSERTS run inside `! draw` and re-fire the reactive query.
// The store exposes no on-demand row iteration, so this app cannot add a
// selection highlight or a resize-safe repaint without re-inserting rows — the
// wall this increment reached. Rendering the INITIAL `git status` is pristine
// and SHOWN; interactive repaint is blocked on that hole.

~import std/io
~import std/string
~import std/store
~import koru/vaxis

const std = @import("std");

~tor git-lines {}
! line { text: string, idx: i64 }
| done usize
| failed string

~proc git-lines|zig {
    const __gg_alloc = std.heap.page_allocator;
    const __gg_res = std.process.Child.run(.{
        .allocator = __gg_alloc,
        .argv = &[_][]const u8{ "git", "status", "--porcelain" },
    }) catch |err| {
        return .{ .failed = @errorName(err) };
    };
    defer __gg_alloc.free(__gg_res.stdout);
    defer __gg_alloc.free(__gg_res.stderr);

    const __gg_ok = __gg_res.term == .Exited and __gg_res.term.Exited == 0;
    if (!__gg_ok) {
        return .{ .failed = "git exited nonzero" };
    }

    var __gg_n: usize = 0;
    var __gg_it = std.mem.splitScalar(u8, __gg_res.stdout, '\n');
    while (__gg_it.next()) |__gg_raw| {
        if (__gg_raw.len == 0 and __gg_it.peek() == null) break;
        line(.{ .text = __gg_raw, .idx = @as(i64, @intCast(__gg_n)) });
        __gg_n += 1;
    }
    return .{ .done = __gg_n };
}

~std/store:new(gitfiles, capacity: 256) { name: *std/string:String<std/string:instance!>, y: i64 }

// The render IS the reaction: each inserted row paints itself at its own line.
~std/store:rule(gitfiles)
! row e |> std/string:read(s: e.name): text |> koru/vaxis:write-at(x: 2, e.y: @as(u16, @intCast(e.y + 2)), text)

~koru/vaxis:run(title: "gitgazer")
! draw _ |> koru/vaxis:write-at(x: 2, y: 0, text: "gitgazer — git status (q to quit)")
    |> git-lines()
        ! line l |> std/string:from-page(l.text)
            | ok s |> std/string:take(s): owned |> std/store:insert(gitfiles) { name: owned, y: l.idx }
                | row _ |> _
            | err _ |> _
        | done _ |> koru/vaxis:render()
        | failed _ |> _
! key k when k.ch == 'q' |> koru/vaxis:quit()
| err e |> std/io:print.ln("vaxis failed: {{ e:s }}")
